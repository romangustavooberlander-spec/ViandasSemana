@startuml cu-general
!include estilo.iuml
title ViandasSemana — Diagrama de casos de uso (general)
left to right direction

actor "Visitante" as Visitante
actor "Usuario" as Usuario
actor "Cliente" as Cliente
actor "Cocinero" as Cocinero
actor "Mercado Pago" as MP <<sistema externo>>
actor "Servicio de correo" as Correo <<sistema externo>>

Cliente -|> Usuario
Cocinero -|> Usuario

rectangle "Sistema ViandasSemana" {
  package "1. Acceso" {
    usecase "CU-01 Registrar cuenta" as CU01
    usecase "CU-02 Iniciar sesión" as CU02
    usecase "CU-03 Cerrar sesión" as CU03
    usecase "CU-04 Recuperar contraseña" as CU04
  }
  package "2. Menús" {
    usecase "CU-05 Consultar menús" as CU05
    usecase "CU-06 Crear menú" as CU06
    usecase "CU-07 Modificar menú" as CU07
    usecase "CU-08 Eliminar menú" as CU08
  }
  package "3. Pedidos" {
    usecase "CU-09 Registrar pedido" as CU09
    usecase "CU-10 Consultar mis pedidos" as CU10
    usecase "CU-11 Cancelar pedido" as CU11
    usecase "CU-12 Consultar viandas a cocinar" as CU12
  }
  package "4. Pagos" {
    usecase "CU-13 Generar orden de pago" as CU13
    usecase "CU-14 Pagar reserva" as CU14
    usecase "CU-15 Confirmar pago" as CU15
    usecase "CU-16 Devolver pago" as CU16
    usecase "CU-17 Vencer reservas impagas" as CU17
  }
}

Visitante --> CU01
Usuario --> CU02
Usuario --> CU03
Usuario --> CU04
CU04 --> Correo

Usuario --> CU05
Cocinero --> CU06
Cocinero --> CU07
Cocinero --> CU08

Cliente --> CU09
Cliente --> CU10
Cliente --> CU11
Cocinero --> CU12

Cliente --> CU14
CU13 --> MP
CU14 --> MP
MP --> CU15
CU16 --> MP

CU09 ..> CU13 : <<include>>
CU05 ..> CU17 : <<include>>
CU09 ..> CU17 : <<include>>
CU10 ..> CU17 : <<include>>
CU14 ..> CU17 : <<include>>
CU16 ..> CU11 : <<extend>>\n[pedido ya pagado]
CU16 ..> CU15 : <<extend>>\n[pago no esperado]
@enduml
