<mxfile host="app.diagrams.net" type="device"><diagram name="ViandasSemana — Arquitectura y despliegue" id="arquitectura"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="ViandasSemana — Arquitectura y despliegue" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0.0" y="-60.0" width="1825.0" height="40.0" as="geometry"/></mxCell><mxCell id="c4" value="Render Static Site (CDN) — https://viandassemana-web.onrender.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="8.0" y="495.0" width="516.0" height="145.0" as="geometry"/></mxCell><mxCell id="c5" value="Render Web Service Free (Virginia) — https://viandassemana.onrender.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="800.0" y="297.0" width="556.0" height="500.0" as="geometry"/></mxCell><mxCell id="c6" value="GitHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="85.0" y="129.0" width="472.0" height="333.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Frontend React + Vite&lt;/b&gt;&lt;br&gt;sitio estático (HTML, JS, CSS)&lt;br&gt;VITE_API_URL fijada al construir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="151.0" y="544.0" width="230.0" height="70.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;API Node 22 + Express 5&lt;/b&gt;&lt;br&gt;/api/health · /api/auth · /api/menus&lt;br