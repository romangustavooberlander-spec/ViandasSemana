@startuml cu-1-autenticacion
!include estilo.iuml
title Módulo 1 — Autenticación: casos de uso
left to right direction
actor "Visitante" as Visitante
actor "Usuario" as Usuario
actor "Cliente" as Cliente
actor "Cocinero" as Cocinero
actor "Servicio de correo" as Correo <<sistema externo>>
Cliente -|> Usuario
Cocinero -|> Usuario
rectangle "Autenticación" {
  usecase "CU-01 Registrar cuenta" as CU01
  usecase "CU-02 Iniciar sesión" as CU02
  usecase "CU-03 Cerrar sesión" as CU03
  usecase "CU-04 Recuperar contraseña" as CU04
}
Visitante --> CU01
Usuario --> CU02
Usuario --> CU03
Usuario --> CU04
CU04 --> Correo
note bottom of CU01
  Toda cuenta nueva es CLIENTE.
  El rol COCINERO se asigna en la base.
end note
@enduml
