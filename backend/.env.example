# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube al repo.

# Conexión a PostgreSQL. En local, la base del docker-compose; en producción, la base remota.
DATABASE_URL=postgresql://viandas:viandas@localhost:5432/viandas_dev

# Clave para firmar los tokens de sesión (JWT). Usar un valor largo y aleatorio.
JWT_SECRET=

# Puerto de la API
PORT=3000

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# --- Correo (Nodemailer por SMTP): códigos para recuperar la contraseña ---
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu cuenta,
# SMTP_PASS=una "contraseña de aplicación" (no la contraseña de la cuenta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente que ve el usuario. Si se deja vacío se usa SMTP_USER.
MAIL_FROM="ViandasSemana <no-responder@ejemplo.com>"

# --- Mercado Pago (Checkout Pro) ---
# Access token PRIVADO de la cuenta que cobra (Tus integraciones > Credenciales).
# Para probar, usar el de prueba (empieza con TEST- o APP_USR- de un usuario de prueba vendedor).
MP_ACCESS_TOKEN=
# Adónde vuelve el cliente después de pagar (la URL del frontend).
FRONTEND_URL=http://localhost:5173
# URL pública de esta API, para que Mercado Pago avise los pagos (webhook).
# En local se deja vacía: el estado se consulta cuando el cliente vuelve de pagar.
API_URL=
