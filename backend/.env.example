# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube al repo.

# Conexión a PostgreSQL. En local, la base del docker-compose; en producción, la base remota.
DATABASE_URL=postgresql://viandas:viandas@localhost:5432/viandas_dev

# Clave para firmar los tokens de sesión (JWT). Usar un valor largo y aleatorio.
JWT_SECRET=

# Puerto de la API
PORT=3000

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
